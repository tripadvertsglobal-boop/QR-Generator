{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // cloudflare-worker.ts imports `.open-next/worker.js`, which only exists after
  // `opennextjs-cloudflare build` — so it resolves or not depending on when the
  // checker runs. Excluding it keeps `tsc --noEmit` deterministic; wrangler
  // type-strips the file at deploy time.
  "exclude": ["node_modules", "cloudflare-worker.ts"]
}
