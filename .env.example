# Required in production. A production build fails if any of these are unset —
# see lib/env.ts, which is the single source of truth for this contract.

# ── Supabase ────────────────────────────────────────────────────────────────
# Public (browser + server, RLS-enforced). Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Server-only. NEVER prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# Origin that serves /r/<slug> redirects (used to build tracking URLs).
NEXT_PUBLIC_REDIRECT_DOMAIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signing secret for password-gate unlock cookies (M7). Generate 32+ random bytes.
# Missing in production = every redirect 500s.
LINK_UNLOCK_SECRET=
# Shared secret protecting Vercel Cron endpoints (M8). Vercel sends it as Bearer.
# Missing in production = the audit-retention purge fails closed with 503.
CRON_SECRET=

# ── Recommended: the app runs without these, but a safety net is off ────────

# Vercel KV / Upstash Redis. Auto-injected when a KV/Upstash store is linked in
# Vercel. Unset = rate limiting and the slug cache are disabled, and the
# redirect engine falls back to Supabase (slower, but functional locally).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google Safe Browsing (M5). Unset = destination URL screening is disabled and
# every submitted URL is treated as safe. Strongly recommended before opening
# signups: without it this is an unscreened public redirector.
SAFE_BROWSING_API_KEY=

# Comma-separated CORS allow-list for /api/v1/* (M8). Unset in production = no
# cross-origin caller can read the API (the same-origin dashboard is unaffected).
ALLOWED_ORIGINS=

# Sentry error monitoring (M8.6). Both are needed for full coverage: SENTRY_DSN
# covers server + edge, NEXT_PUBLIC_SENTRY_DSN covers the browser. Unset =
# Sentry fully disabled (no-op).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time — without them production
# stack traces stay minified. Set all three or none.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────
# Dedicated salt for hashing scan IPs. Falls back to LINK_UNLOCK_SECRET.
SCAN_IP_SALT=
# Set to 1 to serve the CSP as enforcing instead of Report-Only. Deploy without
# it first, confirm /api/csp-report logs are clean, then set it — and unset it
# to roll back. Build-time: changing it needs a redeploy.
CSP_ENFORCE=

# ── Deferred to later milestones (left here as the full contract) ────────────
# QSTASH_TOKEN=                          # M4 ingestion queue
# STRIPE_SECRET_KEY=                     # M6 billing — writes user_profiles.plan
# STRIPE_WEBHOOK_SECRET=                 # M6
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=    # M6
